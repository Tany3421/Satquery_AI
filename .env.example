# ==============================================================================
# SatQuery AI - Environment Configuration (.env)
# ==============================================================================
# Copy this file to '.env' (or 'backend/.env') and configure your settings.
# Do NOT commit your actual .env file with private keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & VLM Reasoning Engines
# ------------------------------------------------------------------------------
# Google Gemini API Key for Satellite Vision-Language Analysis (Required for VLM)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model used for remote sensing inferences
GEMINI_MODEL=gemini-2.0-flash

# Optional: Groq API Key for fast text-only queries
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 2. Database Configuration (Cross-Device Account & Query Sharing)
# ------------------------------------------------------------------------------
# Option A (Local Development): Connect to local MongoDB instance
# Defaults to mongodb://localhost:27017/ (falls back to local SQLite if offline)
MONGO_URI=mongodb://localhost:27017/

# Option B (Shared across Laptop A & Laptop B - RECOMMENDED):
# Create a free database on MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
# and paste your connection string here. Both laptops will instantly share all
# user accounts, query histories, and change-detection reports!
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/satquery?retryWrites=true&w=majority

MONGO_DB_NAME=satquery

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JWT authentication tokens
# Keep this identical across environments if using shared tokens
JWT_SECRET=satquery-production-secret-key-replace-with-random-hex

# ------------------------------------------------------------------------------
# 4. Map & Geospatial Services
# ------------------------------------------------------------------------------
# Optional Mapbox Access Token for high-resolution vector tiles and geocoding
# Get a free token at: https://account.mapbox.com/
# (If omitted, SatQuery AI automatically falls back to 100% free Esri World Imagery & Nominatim)
MAPBOX_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 5. Server Networking
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

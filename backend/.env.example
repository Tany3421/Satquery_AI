# ==============================================================================
# SatQuery AI - Backend Environment Configuration (.env)
# ==============================================================================
# Copy this file to '.env' in this directory (backend/.env)
# ==============================================================================

# AI Vision-Language Engine
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=

# Database Configuration (Shared Atlas URI or Local MongoDB/SQLite)
# To share accounts across multiple laptops, use a free MongoDB Atlas URI:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/satquery?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=satquery

# Authentication & Security
JWT_SECRET=satquery-production-secret-key-replace-with-random-hex

# Optional Mapbox Access Token
MAPBOX_ACCESS_TOKEN=

# Host & Port
HOST=0.0.0.0
PORT=8000
